<Window x:Class="WindowListSample.SampleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360" Height="200"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <StackPanel Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock x:Name="DescriptionText" FontSize="14" Margin="0,0,0,16" TextAlignment="Center" />
        <Button x:Name="CloseDialogButton"
                AutomationProperties.AutomationId="CloseDialogButton"
                Content="閉じる"
                Width="120" Height="32"
                Click="OnCloseClick" />
    </StackPanel>
</Window>